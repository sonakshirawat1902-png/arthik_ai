# Arthik AI - Environment Configuration Template
# Copy this file to .env.local and fill in your actual credentials.
# DO NOT commit .env.local or real secrets to Git repositories.

# Supabase Credentials (Phase 3)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key-here

# Google Gemini API Credentials (Phase 4)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
